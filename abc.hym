            from webdriver_manager.chrome import ChromeDriverManager

            SELENIUM_AVAILABLE = True
        except ImportError:
            SELENIUM_AVAILABLE = False


        class DetailAgent:
            """
            Opens each business on Google Maps and extracts:
            - phone number
            - review count
            - full address
            Then visits website to find email.
